# Retrieval agent connection
RETRIEVAL_SERVICE_URL=http://agent-retrieval:8001
RETRIEVAL_TOP_K=5
RETRIEVAL_TIMEOUT_SECONDS=10.0

# Gemini LLM — get a free-tier key at https://aistudio.google.com/apikey
# NEVER commit this file with a real key filled in — it's .gitignored
# for exactly that reason.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
